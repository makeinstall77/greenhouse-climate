# Copy to /etc/greenhouse-climate.env (mode 600). Do not commit a filled copy.

HA_URL=http://172.16.10.230:8123
HA_TOKEN=REPLACE_WITH_LONG_LIVED_TOKEN

LISTEN=0.0.0.0
PORT=8080
API_KEY=
STATE_PATH=/var/lib/greenhouse-climate/state.json
LOOP_SECONDS=90
DRY_RUN=0
LOG_LEVEL=INFO

AIR_ENTITY=sensor.esp32home_temperature
FLOOR_CLIMATE_ENTITY=climate.smart_thermostat_local_teplyi_pol_local
SUN_ENTITY=sun.sun
HELPER_ENABLED=input_boolean.greenhouse_climate_enabled
HELPER_TARGET=input_number.greenhouse_climate_target

DEADBAND_C=0.5
FLOOR_MIN_C=15
FLOOR_MAX_C=35
SETPOINT_STEP_C=0.5
MIN_WRITE_INTERVAL_S=180
BOOST_DAY_C=2
BOOST_NIGHT_C=3
MARGIN_C=1
SOLAR_OFFSET_C=1.5
DEFAULT_DELTA_C=4
DELTA_HOURS=48
DELTA_REFRESH_S=1800
